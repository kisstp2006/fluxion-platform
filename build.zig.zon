// SPDX-License-Identifier: BSL-1.0

.{
    .name = .fluxion_platform,
    .version = "0.1.0",
    .minimum_zig_version = "0.16.0",
    .fingerprint = 0x47f9b05151a3c35a,
    .dependencies = .{
        // The library's one dependency.
        .fluxion_dyn = .{
            .url = "git+https://github.com/kisstp2006/fluxion-dyn#78c8c2a2ddcad8e90d3b45c0f80023f0b479f26b",
            .hash = "fluxion_dyn-0.1.0-5Dy8EU9PAQAp7cuNi6RU8eu0pgcFXWUbrBq69b7idVnA",
        },

        // What the Vulkan example makes its instance with. Lazy: fetched only
        // when the examples are built, which is when this is the root package
        // or `-Dexamples` is given. The library links nothing of Vulkan and
        // loads nothing of it; a program that depends on `fluxion_platform`
        // never downloads this.
        .fluxion_vulkan = .{
            .url = "git+https://github.com/kisstp2006/fluxion-vulkan#7bec633080135d3891a15a53f3467058bd1b2b7e",
            .hash = "fluxion_vulkan-0.1.0-8VC-cTC0EwBjdBAPtcHQiPoCbsJSPmfWRKr24UFq4U9Y",
            .lazy = true,
        },

        // What the browser examples draw with, and the JavaScript that goes
        // with it. Lazy, for the same reason and on the same terms as the
        // Vulkan binding above: the web backend makes a canvas and a WebGL
        // context on it, and neither loads nor declares a single WebGL call.
        .fluxion_webgl = .{
            .url = "git+https://github.com/kisstp2006/fluxion-webgl#228b85f17702d28660e3fa6745ad7fcb3faa32ee",
            .hash = "fluxion_webgl-0.1.0-8yvbdRdVAwDPfmGZBp5vku1-TRr6fCwl5ka84zXvguxU",
            .lazy = true,
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "examples",
        "README.md",
    },
}
